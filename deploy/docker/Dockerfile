# Noetrix app image: the query API (:8051) and the management console (:8052).
# One image; docker-entrypoint.sh runs both (see it for why they stay together).
#
# Two build layouts, picked by two build args. The Dockerfile is the same file in
# both; only where it finds things differs:
#
#   repo checkout (default)   context = repo root,   APP_DIR=.    DEPLOY_DIR=deploy/docker
#   release archive           context = bundle dir,  APP_DIR=app  DEPLOY_DIR=.
#
# deploy/package/docker-compose.override.yml carries the archive values. Build
# from a checkout with:
#   docker build -f deploy/docker/Dockerfile -t noetrix-rag:local .
#
# NOTHING personal goes into this image: no config, no .env, no corpus, no
# indexes. The config is a file mounted at /app/config.yaml (generated by
# make_docker_config.py); secrets arrive as environment variables or a mounted
# .env; data lives on volumes. Dockerfile.dockerignore enforces the same at the
# context boundary.
#
# Platforms: linux/amd64 and linux/arm64 (Apple Silicon). The base image, the
# CPU torch wheels, Tesseract, Playwright and patchright Chromium all publish
# both; `uv pip compile requirements.txt -c deploy/docker/constraints.txt
# --python-platform aarch64-unknown-linux-gnu --only-binary :all:` proves the
# Python side resolves for arm64 without building anything.

# Debian bookworm, PINNED BY DIGEST. `python:3.11-slim` is a moving tag that rolled
# from bookworm to trixie underneath the OCR sidecar's pinned wheels and broke it
# with a SIGABRT no Python `except` can catch (see ocr-sidecar/Dockerfile). The
# digest is the multi-arch index, so it resolves per platform. To bump it:
#   docker buildx imagetools inspect python:3.11-slim-bookworm
FROM python:3.11.17-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89

ARG APP_DIR=.
ARG DEPLOY_DIR=deploy/docker
# Keep equal to the torch in the project venv (the version the tests run on).
ARG TORCH_VERSION=2.13.0
# Numeric on purpose: Kubernetes' runAsNonRoot cannot verify a USER given by name.
ARG APP_UID=10001
ARG APP_GID=10001

# Tesseract = the OCR engine for scanned PDFs, INSTALLED IN THIS IMAGE -- nothing
# to set up on the host. The -eng and -osd data packages are named explicitly so
# `tesseract --list-langs` is never empty (the console's OCR panel reports exactly
# this) and page-orientation detection works. The other OCR lanes (the PaddleOCR
# sidecar, `ocr_engine: vlm`) are separate services on purpose: a document VLM on
# container CPU is minutes per page.
# curl = the health probes.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      tesseract-ocr tesseract-ocr-eng tesseract-ocr-osd curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid ${APP_GID} noetrix \
 && useradd --uid ${APP_UID} --gid ${APP_GID} --home-dir /home/noetrix \
            --create-home --shell /usr/sbin/nologin noetrix

WORKDIR /app

# CPU-only PyTorch FIRST. The RAG runs bge-small and the cross-encoder on CPU and
# there is no GPU in this container (least of all on a Mac). Default torch on x86
# Linux drags in ~5GB of unused NVIDIA CUDA wheels; the CPU index avoids that.
# Pip then sees torch as already satisfied, so sentence-transformers cannot swap
# in the CUDA build.
RUN pip install --no-cache-dir "torch==${TORCH_VERSION}" \
      --index-url https://download.pytorch.org/whl/cpu

# The rest, layer-cached on the two files that decide it. requirements.txt pins
# the direct dependencies; constraints.txt pins the transitive ML stack so a
# rebuild cannot resolve to a newer transformers/huggingface-hub than the one
# the project is tested with. Do NOT add rapidocr-onnxruntime -- it makes
# pymupdf4llm pick a broken OCR adaptor (see the note in requirements.txt).
COPY ${APP_DIR}/requirements.txt /tmp/build/requirements.txt
COPY ${DEPLOY_DIR}/constraints.txt /tmp/build/constraints.txt
RUN pip install --no-cache-dir -r /tmp/build/requirements.txt -c /tmp/build/constraints.txt \
 && rm -rf /tmp/build

# Headless Chromium for the fetch->pdf lane (playwright itself comes from
# requirements.txt). --with-deps pulls the system libraries Chromium needs on
# debian-slim; the fixed browsers path keeps it out of /root and readable by the
# non-root user.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN python -m playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/*
# Scrapling's stealth fetcher drives Chromium through patchright, which needs its
# own install (the system libraries above already cover it).
RUN python -m patchright install chromium \
 && chmod -R a+rX /ms-playwright
# Crawlee, unlike plain Playwright, keeps Chromium's sandbox ON. The sandbox needs
# user namespaces, which a default container (Docker's seccomp profile, a
# Kubernetes pod without extra privileges) does not grant -- root or not -- so
# the opt-in crawlee fetch backend needs it off here. Running as non-root is not
# a substitute for the sandbox; it is the reason not to grant the privileges.
ENV CRAWLEE_DISABLE_BROWSER_SANDBOX=1

# The application: an explicit list, not `COPY .`. Whatever else sits in the
# context (docs, tests, the other sidecars, an eval set, a stray file) stays out
# of the image even if Dockerfile.dockerignore misses it.
# VERSION is required: src/utils/release.py refuses to import without it.
COPY --chown=${APP_UID}:${APP_GID} ${APP_DIR}/*.py ${APP_DIR}/requirements.txt ${APP_DIR}/VERSION ${APP_DIR}/CHANGELOG.md /app/
COPY --chown=${APP_UID}:${APP_GID} ${APP_DIR}/src   /app/src
COPY --chown=${APP_UID}:${APP_GID} ${APP_DIR}/webui /app/webui
COPY --chown=${APP_UID}:${APP_GID} ${APP_DIR}/eval  /app/eval
COPY --chown=${APP_UID}:${APP_GID} ${APP_DIR}/tools /app/tools

COPY ${DEPLOY_DIR}/docker-entrypoint.sh ${DEPLOY_DIR}/healthcheck.sh /usr/local/bin/
# sed: a Windows checkout with core.autocrlf would otherwise hand the shell a
# "#!/bin/sh\r" and the container dies with "not found".
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh /usr/local/bin/healthcheck.sh \
 && chmod 0755 /usr/local/bin/docker-entrypoint.sh /usr/local/bin/healthcheck.sh \
 && mkdir -p /app/data /app/logs /app/eval/sets /rag_data /hf_cache /tmp/scratch \
 && chown ${APP_UID}:${APP_GID} /app/data /app/logs /app/eval/sets /rag_data /hf_cache /tmp/scratch

# Every path the process writes to is one of these: volumes (data, indexes, model
# cache, job logs), the two mounted files (/app/config.yaml, /app/.env), or /tmp.
# The model cache lives on a volume so bge-small and the cross-encoder download
# once. UTF-8 so logs never crash.
ENV HF_HOME=/hf_cache \
    SENTENCE_TRANSFORMERS_HOME=/hf_cache/st \
    PYTHONIOENCODING=utf-8 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/noetrix

USER ${APP_UID}:${APP_GID}

EXPOSE 8051 8052

# READY, not merely up: /health answers 200 while the index is still loading and
# while the pipeline has failed to build, so only `"ready":true` is a pass. The
# start period covers loading both indexes and the models on a cold volume.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
  CMD ["healthcheck.sh"]

CMD ["docker-entrypoint.sh"]
